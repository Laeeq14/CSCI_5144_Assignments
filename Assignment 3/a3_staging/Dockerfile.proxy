# Dockerfile.proxy — builds the consistent-hashing proxy image
FROM golang:1.27-alpine AS builder

WORKDIR /build
COPY proxy/go.mod ./
RUN go mod download
COPY proxy/main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o proxy .

FROM alpine:3.19
RUN apk --no-cache add ca-certificates && \
    addgroup -S proxygroup && \
    adduser  -S proxyuser -G proxygroup

WORKDIR /app
COPY --from=builder /build/proxy ./proxy
USER proxyuser

ENV LISTEN_ADDR=0.0.0.0:8000
EXPOSE 8000

ENTRYPOINT ["/app/proxy"]

